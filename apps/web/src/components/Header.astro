---
// Header site — GỌN, tĩnh: Brand + Home. Không hero, không menu category,
// không navigation động (Sprint 3 Phase 1 — content first, chrome second).
import { getSiteSettings } from '../lib/directus';

const { siteName } = await getSiteSettings();
---

<header class="site-header">
  <a class="brand" href="/">▚ {siteName.toUpperCase()} ▞</a>
  <nav class="site-nav" aria-label="Điều hướng chính">
    <a href="/">Trang chủ</a>
    <a href="/categories">Chuyên mục</a>
    <a href="/archive">Lưu trữ</a>
    <a href="/search">Tìm kiếm</a>
    <div class="theme-picker" hidden>
      <label for="theme-select">Giao diện</label>
      <select id="theme-select"></select>
    </div>
  </nav>
</header>

<script>
  import '../scripts/theme';
</script>
