---
// Pagination — Trước/Sau + DÃY SỐ TRANG click được (Sprint 6.5, R8). A11y:
// - LINK chỉ khi có trang đích; ở BIÊN (đầu/cuối) là span disabled, KHÔNG điều hướng.
// - Số trang: link tới trang đích; trang hiện tại là span aria-current, không link.
// - Cửa sổ rút gọn với "…" (ellipsis) → quy mô lớn (50+ trang) vẫn nhảy được đầu/cuối.
// - <nav aria-label> + rel=prev/next. Chỉ render khi có >1 trang.
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;    // URL trang 1 (vd "/" hoặc "/category/cpu")
  pagePrefix: string; // tiền tố trang 2+ (append "/N"), vd "/page" hoặc "/category/cpu/page"
}
const { currentPage, totalPages, baseUrl, pagePrefix } = Astro.props;
const pageUrl = (n: number) => (n <= 1 ? baseUrl : `${pagePrefix}/${n}`);
const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;

// Cửa sổ số trang: luôn hiện trang 1 & trang cuối + lân cận trang hiện tại;
// chèn 'gap' khi có khoảng đứt để render "…".
const window = [...new Set([1, currentPage - 1, currentPage, currentPage + 1, totalPages])]
  .filter((n) => n >= 1 && n <= totalPages)
  .sort((a, b) => a - b);
const cells: (number | 'gap')[] = [];
let prev = 0;
for (const n of window) {
  if (prev && n - prev > 1) cells.push('gap');
  cells.push(n);
  prev = n;
}
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Phân trang">
      {hasPrev ? (
        <a class="pagination__link" rel="prev" href={pageUrl(currentPage - 1)}>
          ← Trước
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-disabled="true">← Trước</span>
      )}

      <span class="pagination__pages">
        {cells.map((c) =>
          c === 'gap' ? (
            <span class="pagination__ellipsis" aria-hidden="true">…</span>
          ) : c === currentPage ? (
            <span class="pagination__page pagination__page--current" aria-current="page">
              {c}
            </span>
          ) : (
            <a class="pagination__page" href={pageUrl(c)} aria-label={`Trang ${c}`}>
              {c}
            </a>
          ),
        )}
      </span>

      {hasNext ? (
        <a class="pagination__link" rel="next" href={pageUrl(currentPage + 1)}>
          Sau →
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-disabled="true">Sau →</span>
      )}
    </nav>
  )
}
