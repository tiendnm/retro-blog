---
// Trang DANH SÁCH bài viết (thay trang plumbing Sprint 1).
// Chỉ dùng thin client → nhận DTO PostSummary; KHÔNG gọi Directus trực tiếp.
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { listPublishedPosts } from '../lib/directus';

const { items } = await listPublishedPosts({ pageSize: 50 });
---

<Base title="Retro Blog — Bài viết mới nhất" description="Blog headless phong cách retro.">
  <h1>Bài viết mới nhất</h1>
  {items.length === 0 && <p>Chưa có bài viết nào được xuất bản.</p>}
  <ul class="post-list">
    {items.map((post) => <PostCard post={post} />)}
  </ul>
</Base>
