---
// Trang DANH SÁCH bài viết — TRANG 1 (page 2+ ở /page/[page]).
// Chỉ dùng thin client → DTO; KHÔNG gọi Directus trực tiếp.
import Base from '../layouts/Base.astro';
import PostListView from '../components/PostListView.astro';
import { listPublishedPosts } from '../lib/directus';

const { items, pageInfo } = await listPublishedPosts({ page: 1 });
const totalPages = Math.max(1, Math.ceil(pageInfo.total / pageInfo.pageSize));
---

<Base title="Retro Blog — Bài viết mới nhất" description="Blog headless phong cách retro.">
  <PostListView
    heading="Bài viết mới nhất"
    items={items}
    emptyText="Chưa có bài viết nào được xuất bản."
    currentPage={1}
    totalPages={totalPages}
    baseUrl="/"
    pagePrefix="/page"
  />
</Base>
