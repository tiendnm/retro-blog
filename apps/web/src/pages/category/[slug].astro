---
// Trang CHUYÊN MỤC — TRANG 1 (page 2+ ở /category/[slug]/page/[page]). Route tĩnh.
// Chỉ dùng thin client → DTO; KHÔNG gọi Directus trực tiếp.
import Base from '../../layouts/Base.astro';
import PostListView from '../../components/PostListView.astro';
import { getAllCategorySlugs, getCategoryBySlug, listPostsByCategory } from '../../lib/directus';

export async function getStaticPaths() {
  const slugs = await getAllCategorySlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const category = await getCategoryBySlug(slug!);
if (!category) throw new Error(`Không tìm thấy chuyên mục: ${slug}`);

const { items, pageInfo } = await listPostsByCategory(slug!, { page: 1 });
const totalPages = Math.max(1, Math.ceil(pageInfo.total / pageInfo.pageSize));
---

<Base title={`${category.name} — Retro Blog`}>
  <PostListView
    heading={`Chuyên mục: ${category.name}`}
    items={items}
    emptyText="Chưa có bài viết trong chuyên mục này."
    currentPage={1}
    totalPages={totalPages}
    baseUrl={`/category/${slug}`}
    pagePrefix={`/category/${slug}/page`}
    backLink
  />
</Base>
