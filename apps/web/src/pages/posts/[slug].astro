---
// Trang CHI TIẾT bài viết. Route tĩnh dựng từ danh sách slug đã publish (SSG,
// ADR-0006). Chỉ dùng thin client → DTO PostDetail; KHÔNG gọi Directus trực tiếp.
// Phần hiển thị nằm ở PostPage (dùng chung với máy chủ xem trước bản nháp — `preview/`).
import PostPage from '../../components/PostPage.astro';
import {
  getAllPublishedPostSlugs,
  getPostBySlug,
  getPostSlugRedirects,
} from '../../lib/directus';

export async function getStaticPaths() {
  const [slugs, redirects] = await Promise.all([getAllPublishedPostSlugs(), getPostSlugRedirects()]);
  // Slug cũ (previous_slugs) → trang chuyển hướng tới slug hiện tại; sitemap/RSS chỉ liệt kê slug sống.
  return [
    ...slugs.map((slug) => ({ params: { slug }, props: { redirectTo: null as string | null } })),
    ...redirects.map((r) => ({ params: { slug: r.from }, props: { redirectTo: r.to as string | null } })),
  ];
}

const { slug } = Astro.params;
const { redirectTo } = Astro.props;
// Bản build tĩnh: Astro.redirect sinh trang <meta http-equiv="refresh"> + canonical (không cần script → hợp CSP).
if (redirectTo) return Astro.redirect(`/posts/${redirectTo}`, 301);

const post = await getPostBySlug(slug!);
// getStaticPaths chỉ sinh slug hợp lệ ⇒ nhánh này chỉ là chốt an toàn khi build.
if (!post) throw new Error(`Không tìm thấy bài đã xuất bản: ${slug}`);
---

<PostPage post={post} />
