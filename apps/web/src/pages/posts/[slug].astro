---
// Trang CHI TIẾT bài viết. Route tĩnh dựng từ danh sách slug đã publish (SSG,
// ADR-0006). Chỉ dùng thin client → DTO PostDetail; KHÔNG gọi Directus trực tiếp.
import Base from '../../layouts/Base.astro';
import CoverImage from '../../components/CoverImage.astro';
import { formatDate } from '../../lib/format';
import { getAllPublishedPostSlugs, getPostBySlug } from '../../lib/directus';
import { marked } from 'marked';

export async function getStaticPaths() {
  const slugs = await getAllPublishedPostSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
// getStaticPaths chỉ sinh slug hợp lệ ⇒ nhánh này chỉ là chốt an toàn khi build.
if (!post) throw new Error(`Không tìm thấy bài đã xuất bản: ${slug}`);

// body là markdown (03c: input-rich-text-md). Nội dung do Editor tin cậy nhập
// (MVP, không nhận input công khai). Sanitize HTML: hardening tương lai (12-security §8).
const bodyHtml = post.body ? await marked.parse(post.body) : '';

// URL/ảnh tuyệt đối cho structured data + article meta (Sprint 6.5).
const site = Astro.site;
const pageUrl = site ? new URL(`/posts/${post.slug}`, site).href : `/posts/${post.slug}`;
const imageAbs = post.cover?.url
  ? (site ? new URL(post.cover.url, site).href : post.cover.url)
  : (site ? new URL('/og-default.png', site).href : '/og-default.png');

// JSON-LD BlogPosting — chỉ dùng field DTO sẵn có, không đổi kiến trúc (R3).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  ...(post.excerpt ? { description: post.excerpt } : {}),
  ...(post.publishedAt ? { datePublished: post.publishedAt } : {}),
  author: { '@type': 'Person', name: post.author.name },
  ...(post.category ? { articleSection: post.category.name } : {}),
  image: imageAbs,
  mainEntityOfPage: pageUrl,
  publisher: { '@type': 'Organization', name: 'Retro Blog' },
};
// Escape '<' để chuỗi JSON không thể phá vỡ ngữ cảnh <script> (nội dung tin cậy, vẫn hardening).
const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<Base
  title={`${post.title} — Retro Blog`}
  description={post.excerpt ?? undefined}
  type="article"
  image={post.cover?.url}
>
  <Fragment slot="head">
    {post.publishedAt && <meta property="article:published_time" content={post.publishedAt} />}
    <meta property="article:author" content={post.author.name} />
    {post.category && <meta property="article:section" content={post.category.name} />}
    <script type="application/ld+json" set:html={jsonLdScript} />
  </Fragment>
  <article class="post">
    <header class="post__header">
      <h1>{post.title}</h1>
      <p class="meta">
        Bởi {post.author.name}
        {
          post.category && (
            <>
              {' · '}
              <a href={`/category/${post.category.slug}`}>{post.category.name}</a>
            </>
          )
        }
        {post.publishedAt && ` · ${formatDate(post.publishedAt)}`}
      </p>
    </header>
    {
      post.cover && (
        <CoverImage class="post__cover" src={post.cover.url} alt={post.cover.alt} />
      )
    }
    <div class="prose" set:html={bodyHtml}></div>
  </article>
</Base>
