---
// Layout shell (Sprint 3 Phase 1): skip-link → Header → main → Footer.
// HTML ngữ nghĩa + a11y baseline (lang, landmark, skip-link). Content first,
// chrome second — không sidebar/widget/trang trí. Không gọi Directus.
//
// SEO baseline (Sprint 5 Phase 2): canonical + OpenGraph + Twitter card.
// - Địa chỉ tuyệt đối dẫn xuất từ `Astro.site` (= PUBLIC_SITE_URL ở astro.config).
// - Canonical = SELF-REFERENCING: mỗi trang (kể cả pagination /page/N) trỏ về
//   CHÍNH URL của nó — trang pagination là danh sách riêng, cần index được để
//   độc giả tới mọi bài. Sitemap chỉ liệt kê canonical *content* URL (S5-P0).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Ảnh chia sẻ (og:image/twitter:image) — URL tuyệt đối, dùng khi bài có cover. */
  image?: string;
  /** og:type — 'article' cho trang chi tiết, 'website' cho phần còn lại. */
  type?: 'website' | 'article';
}
const { title, description, image, type = 'website' } = Astro.props;

const SITE_NAME = 'Retro Blog';

// Chuẩn hoá path (bỏ trailing slash trừ gốc) để canonical KHỚP TUYỆT ĐỐI với
// loc trong sitemap.xml (cùng dạng không-trailing). `Astro.site` luôn có vì
// astro.config khai báo `site`; fallback path tương đối chỉ là chốt an toàn.
const rawPath = Astro.url.pathname;
const path = rawPath !== '/' ? rawPath.replace(/\/$/, '') : '/';
const canonical = Astro.site ? new URL(path, Astro.site).href : path;
const ogImage = image ? (Astro.site ? new URL(image, Astro.site).href : image) : undefined;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    {/* OpenGraph — link chia sẻ (Facebook/Zalo/…) hiển thị đẹp */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter card */}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua tới nội dung</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
