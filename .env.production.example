# ============================================================
# Retro Blog — mẫu biến môi trường PRODUCTION (Sprint 6)
# Sao chép thành `.env.production` TRÊN SERVER; điền domain thật + secrets mạnh.
# KHÔNG commit `.env.production`. Nguyên tắc: không secret trong repo (12-security).
# Dùng: docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#         --env-file .env.production up -d
# `retro.<domain>` / `retro-cms.<domain>` là PLACEHOLDER — thay <domain> khi deploy.
# ============================================================

# ─── Compose ───
# Danh sách file compose, nên không phải gõ -f. Bỏ docker-compose.tunnel.yml nếu dùng Caddy + TLS trực tiếp (VPS).
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.prod.yml,docker-compose.tunnel.yml

# ─── Directus DB ───
DB_CLIENT=pg
# Postgres chạy TRONG compose (ADR-0014): host = tên service, cổng nội bộ 5432.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=retro-blog
DB_USER=postgres
DB_PASSWORD=__CHANGE_ME_strong_password__

# Bảo mật Directus — SINH NGẪU NHIÊN (openssl rand -hex 32). BẮT BUỘC đổi.
KEY=__CHANGE_ME_openssl_rand_hex_32__
SECRET=__CHANGE_ME_openssl_rand_hex_32__

# Admin khởi tạo — đổi ngay sau lần đầu + BẬT 2FA (12-security §3).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__CHANGE_ME_strong_password__

# ─── Domain / TLS (Caddy — ADR-0007) ───
# Site (SSG tĩnh) và CMS (Directus) tách subdomain (08-deployment §2). Vd: retro.tiendnm.com / retro-cms.tiendnm.com.
SITE_DOMAIN=retro.<domain>
CMS_DOMAIN=retro-cms.<domain>
# Email cho Let's Encrypt/ACME (thông báo hết hạn chứng chỉ).
ACME_EMAIL=admin@<domain>

# ─── Directus public ───
# PUBLIC_URL của Directus = qua Caddy (cms). Dùng cho admin + link asset.
PUBLIC_URL=https://retro-cms.<domain>

# ─── Astro (Presentation — ADR-0002) ───
# Server-side fetch nội bộ (network container) — KHÔNG đổi (http nội bộ).
DIRECTUS_INTERNAL_URL=http://directus:8055
# Browser tải asset (og:image, ảnh) qua Caddy (cms) — HTTPS domain thật.
PUBLIC_DIRECTUS_URL=https://retro-cms.<domain>
# Site URL cho canonical/OG/sitemap (Sprint 5) — HTTPS domain thật.
PUBLIC_SITE_URL=https://retro.<domain>
WEB_PORT=4321

# ─── Rebuild-on-publish (ADR-0008, ADR-0016) ───
# Receiver chạy TRONG container web (mạng compose, không publish cổng). Directus Flow gọi http://web:9000/rebuild.
# Token bảo vệ webhook: SINH NGẪU NHIÊN (openssl rand -hex 32), >= 32 ký tự; chỉ gửi qua header x-rebuild-token.
# Mỗi biến một dòng; chú thích để dòng riêng như thế này, đừng viết cuối dòng giá trị.
REBUILD_TOKEN=__CHANGE_ME_openssl_rand_hex_32__
# Cổng receiver trong container web.
REBUILD_PORT=9000
# URL Directus (container) gọi tới receiver — tên service `web` trong mạng compose.
REBUILD_WEBHOOK_URL=http://web:9000/rebuild
# Số build giữ lại cho rollback (atomic swap).
KEEP_BUILDS=5

# ─── Vận hành: service ops (backup + healthcheck — ADR-0017) ───
# uid/gid user triển khai (script deploy-home.sh tự điền: `id -u` / `id -g`) — file backup thuộc user này.
DEPLOY_UID=1000
DEPLOY_GID=1000
# Múi giờ cho lịch backup.
TZ=Asia/Ho_Chi_Minh
# Thư mục backup trên HOST (bind mount; phải tồn tại và thuộc DEPLOY_UID). Nhớ copy backup RA NGOÀI host.
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Giờ backup hằng ngày (HH:MM theo TZ). Máy tắt lúc đó → tự chạy bù khi bật lại.
BACKUP_AT=03:30
# Giám sát (tuỳ chọn): URL ping kiểu healthchecks.io — gọi khi OK, URL/fail khi lỗi; báo động khi mất ping.
HEALTHCHECK_PING_URL=

# ─── Cloudflare Tunnel (ADR-0015) — chỉ khi dùng docker-compose.tunnel.yml ───
# Token lấy ở Cloudflare Zero Trust → Networks → Tunnels → (tunnel của bạn) → token. BÍ MẬT, không commit.
TUNNEL_TOKEN=__CHANGE_ME_cloudflare_tunnel_token__
# Caddy lắng nghe HTTP thuần (TLS do Cloudflare lo). Bỏ 2 dòng này nếu dùng Caddy auto-TLS trực tiếp.
SITE_ADDRESS=http://retro.<domain>
CMS_ADDRESS=http://retro-cms.<domain>
# Máy nhỏ (4 GB): trần heap Node khi astro build.
BUILD_NODE_OPTIONS=--max-old-space-size=1536
