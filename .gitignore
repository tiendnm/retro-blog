# ─── Dependencies ───
node_modules/
.pnpm-store/
# Lockfile BẮT BUỘC track (Dockerfile + CI dùng --frozen-lockfile để build tái lập)
# → override ~/.gitignore_global (có 'pnpm-lock.yaml'):
!apps/web/pnpm-lock.yaml

# ─── Env & secrets (KHÔNG commit giá trị thật; chỉ .env.example được track) ───
.env
.env.local
.env.*.local
.env.production
# override global ~/.gitignore_global (có '.env.*') để GIỮ track file template:
!.env.example
!.env.production.example

# Backup (chứa DB + secrets → NHẠY CẢM, không commit):
/backups/

# ─── Astro ───
apps/web/dist/
apps/web/.astro/
.output/

# ─── Build / cache / logs ───
dist/
build/
.cache/
*.log
logs/

# ─── Directus (dữ liệu/uploads local nếu bind-mount; named volume do Docker quản lý) ───
services/directus/uploads/
services/directus/database/

# ─── OS / editor ───
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.deploy-state

# ─── E2E / Lighthouse (e2e/) ───
# Lockfile của e2e BẮT BUỘC track (CI dùng --frozen-lockfile) → override ~/.gitignore_global:
!e2e/pnpm-lock.yaml
e2e/test-results/
e2e/playwright-report/
e2e/.lighthouseci/
