[Unit]
Description=Retro Blog — backup (db + uploads + config + env)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=retro
WorkingDirectory=/opt/retro-blog
EnvironmentFile=/opt/retro-blog/.env.production
Environment="COMPOSE_FILES=-f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production"
Environment=ENV_FILE=.env.production
Environment=BACKUP_DIR=/var/backups/retro-blog
Environment=BACKUP_KEEP=14
# Postgres trong compose (ADR-0014): pg_dump chạy trong container, user/DB lấy từ env file.
ExecStart=/bin/sh -c 'PG_VIA_COMPOSE=1 PGUSER="$$DB_USER" PGDB="$$DB_DATABASE" exec sh services/ops/backup.sh'
