{
  "name": "retro-blog",
  "version": "0.0.0",
  "private": true,
  "description": "Retro Blog — nền tảng blog headless (Astro + Directus + PostgreSQL). Tài liệu: ./docs.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose stop",
    "restart": "docker compose restart",
    "logs": "docker compose logs -f",
    "status": "docker compose ps",
    "down": "docker compose down",
    "schema:apply": "docker compose exec -T directus npx directus schema apply --yes //directus/snapshots/schema.yaml",
    "permissions:apply": "bash services/directus/apply-permissions.sh",
    "seed:dev": "node services/directus/seed/seed-dev.mjs",
    "fixtures:generate": "node services/directus/fixtures/framework/generator.mjs",
    "fixtures:load": "node services/directus/fixtures/loader/load.mjs",
    "fixtures:reset": "node services/directus/fixtures/loader/reset.mjs",
    "rebuild:flow": "node services/directus/apply-rebuild-flow.mjs",
    "rebuild:run": "sh services/rebuild/rebuild.sh",
    "backup": "sh services/ops/backup.sh",
    "restore": "sh services/ops/restore.sh"
  }
}
