# ============================================================
# Retro Blog — mẫu biến môi trường (Sprint 1)
# Sao chép thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Nguyên tắc: không secret trong repo (12-security, P4/P5).
# ============================================================

# ─── Directus (Headless Content Service — ADR-0003) ───
# Kết nối DB: PostgreSQL có sẵn trên host (cổng 5433), DB riêng 'retro-blog' (ADR-0010).
DB_CLIENT=pg
DB_HOST=host.docker.internal
DB_PORT=5433
DB_DATABASE=retro-blog
DB_USER=postgres
DB_PASSWORD=change_me_dev_only

# Bảo mật Directus — SINH NGẪU NHIÊN (vd: `openssl rand -hex 32`). KHÔNG dùng giá trị mẫu ở production.
KEY=replace_with_random_key
SECRET=replace_with_random_secret

# Tài khoản admin khởi tạo (chỉ dùng lần đầu để đăng nhập, đổi ngay sau đó)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_dev_only

# Cổng & URL công khai của Directus
DIRECTUS_PORT=8055
PUBLIC_URL=http://localhost:8055

# ─── Astro (Presentation — ADR-0002) ───
# URL server-side (trong container) tới Directus qua network nội bộ (tên service):
DIRECTUS_INTERNAL_URL=http://directus:8055
# URL client-side (browser) tới Directus (public; không nhúng secret — 06-api):
PUBLIC_DIRECTUS_URL=http://localhost:8055
# URL công khai của SITE cho SEO (canonical/OpenGraph/sitemap/robots) — Sprint 5.
# Tạm dev; CHỐT domain thật ở Sprint 6 (deploy). Đổi 1 chỗ → cả canonical/OG/sitemap/robots đúng.
PUBLIC_SITE_URL=http://localhost:4321
WEB_PORT=4321
